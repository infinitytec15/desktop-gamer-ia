# Web + API. Nunca copie segredos reais para arquivos versionados.
NODE_ENV=production
PORT=8080
APP_URL=https://SEU-DOMINIO.up.railway.app
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/railway
DATABASE_SSL=false
DB_POOL_MAX=12
ADMIN_EMAIL=SEU-EMAIL
ADMIN_PASSWORD=SUBSTITUA-POR-UMA-SENHA-ALEATORIA-DE-16-OU-MAIS-CARACTERES
# Gere com npm run secrets -w @gameforge/api e importe de forma privada.
SESSION_SECRET=
LICENSE_PEPPER=
PROVIDER_ENCRYPTION_KEY=
LICENSE_PRIVATE_KEY=
# Cobrança fica bloqueada até configurar e homologar os campos abaixo.
BILLING_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_LIVE_MODE=true
MP_CANCEL_STATUS=cancelled
# Pode usar ambiente ou cadastrar no cofre pelo admin.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-6.1-sol
WORKER_ENABLED=true
DESKTOP_DOWNLOAD_URL=
# Somente para compilar o instalador. Chave pública mostrada no admin.
GAMEFORGE_API_URL=
GAMEFORGE_LICENSE_PUBLIC_KEY_B64=

# Optional: enable only after verified macOS artifact publication
DESKTOP_MAC_DOWNLOAD_URL=
