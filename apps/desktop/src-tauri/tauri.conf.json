{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameForge AI",
  "version": "0.3.0",
  "identifier": "app.gameforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GameForge AI",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "GameForge AI",
    "shortDescription": "Diagnóstico, otimização revisável e streaming com IA",
    "longDescription": "GameForge AI reúne diagnóstico do PC, planejamento com Claude e OpenAI, ajustes Windows revisáveis e perfis OBS de streaming. Versão beta com aprovações e histórico de recuperação.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "GameForge AI",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
